<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CheckWvDeps" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DepsDir)src\wv\include\wavpack.h')" Text="WavPack headers are missing. Run scripts/fetch-dependencies.ps1 first." />
    <Error Condition="!Exists('$(DepsDir)lib\wv\$(Platform)\Release\libwavpack.lib')" Text="WavPack library is missing. Run scripts/fetch-dependencies.ps1 first." />
  </Target>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DepsDir)src\wv\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>libwavpack.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(DepsDir)lib\wv\$(Platform)\Release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(ProjectDir)codecs\wv\main.cpp" />
  </ItemGroup>
</Project>
