<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CheckSrlaDeps" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DepsDir)src\srla\include\srla_decoder.h')" Text="SRLA headers are missing. Run scripts/fetch-dependencies.ps1 first." />
    <Error Condition="!Exists('$(DepsDir)lib\srla\$(Platform)\Release\srladec.lib')" Text="SRLA libraries are missing. Run scripts/fetch-dependencies.ps1 first." />
  </Target>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DepsDir)src\srla\include;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>srladec.lib;srlacodec.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(DepsDir)lib\srla\$(Platform)\Release;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(ProjectDir)codecs\srla\main.cpp" />
  </ItemGroup>
</Project>
