<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Target Name="CheckOpusDeps" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DepsDir)installed\x64-release\include\opus\opusfile.h')" Text="Opus headers are missing. Run scripts/fetch-dependencies.ps1 first." />
    <Error Condition="!Exists('$(DepsDir)installed\x64-release\lib\opusfile.lib')" Text="Opus libraries are missing. Run scripts/fetch-dependencies.ps1 first." />
  </Target>
  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalIncludeDirectories>$(DepsDir)installed\x64-release\include;$(DepsDir)installed\x64-release\include\opus;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <AdditionalDependencies>opusfile.lib;opus.lib;ogg.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <AdditionalLibraryDirectories>$(DepsDir)installed\x64-release\lib;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="$(ProjectDir)codecs\opus\main.cpp" />
  </ItemGroup>
</Project>
